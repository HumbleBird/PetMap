@using Microsoft.AspNetCore.Identity
@using PetMap.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="account-manage-nav-list">
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage" Match="NavLinkMatch.All">프로필</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage/Email">이메일</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage/ChangePassword">비밀번호</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class="account-manage-nav-link" href="Account/Manage/ExternalLogins">연결된 로그인</NavLink>
        </li>
    }
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage/TwoFactorAuthentication">2단계 인증</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage/Passkeys">패스키</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="account-manage-nav-link" href="Account/Manage/PersonalData">개인정보</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
