@inherits LayoutComponentBase
@layout PetMap.Components.Layout.AccountLayout

<div class="account-content account-manage-content">
    <h1 class="account-page-title">설정</h1>

    <section class="account-intro" aria-label="계정 안내">
        <span class="account-intro-icon" aria-hidden="true">◎</span>
        <span>
            <strong>계정</strong>
            <small>닉네임, 이메일, 비밀번호와 계정 보안 설정을 관리할 수 있어요.</small>
        </span>
    </section>

    <section class="account-auth-section account-manage-section">
        <h2>내 계정 관리</h2>
        <nav class="account-manage-nav" aria-label="계정 설정 메뉴">
            <ManageNavMenu />
        </nav>
        <div class="account-manage-panel">
            @Body
        </div>
    </section>
</div>
