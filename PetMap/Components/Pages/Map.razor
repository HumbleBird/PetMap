@page "/map"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using PetMap.Data.Entities

@inject IJSRuntime JS
@inject PetMap.Data.ApplicationDbContext Db

<h3>PetMap</h3>

<div style="margin-bottom: 15px;">
    <button @onclick='() => FilterCategory("전체")'>
        전체
    </button>

    <button @onclick='() => FilterCategory("동물병원")'>
        동물병원
    </button>

    <button @onclick='() => FilterCategory("용품점")'>
        용품점
    </button>

    <button @onclick='() => FilterCategory("공원")'>
        공원
    </button>

    <button @onclick='() => FilterCategory("미용")'>
        미용
    </button>
</div>

<div id="map"></div>

<style>
    #map {
        width: 100%;
        height: 600px;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // DB에서 장소 가져오기
            var places = await Db.Places
                .Select(p => new
                {
                    p.Id,
                    p.Name,
                    p.Address,
                    p.Latitude,
                    p.Longitude,
                    p.Description,
                    p.Category
                })
                .ToListAsync();

            // JS로 전달
            await JS.InvokeVoidAsync("petMap.init", places);
        }
    }

    private async Task FilterCategory(string category)
    {
        await JS.InvokeVoidAsync("petMap.filterCategory", category);
    }
}