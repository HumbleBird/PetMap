    }

    .filter-open-button {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        border: 1px solid #e2e5e9;
        border-radius: 10px;
        background: #fff;
        color: #252a34;
        font-weight: 600;
        cursor: pointer;
    }

    .filter-count {
        padding: 3px 8px;
        border-radius: 6px;
        background: #eef4ff;
        color: #3568c0;
        font-size: 12px;
    }

    .filter-backdrop {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
