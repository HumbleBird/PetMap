@page "/map"
@layout PetMap.Components.Layout.LandingLayout
@rendermode InteractiveServer

@using PetMap.Data.Utiles
@using PetMap.Components.Pages.Models
@using Microsoft.EntityFrameworkCore
@using PetMap.Components.Pages.Main
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime JS

@inject PetMap.Data.ApplicationDbContext Db
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment

<PageTitle>지도 | 댕동여지도</PageTitle>

<div class="map-page">
    <header class="map-page-header">
        <a class="map-home-link" href="/" aria-label="랜딩 페이지로 이동">댕동여지도</a>
        <nav class="map-header-actions" aria-label="사용자 메뉴">
            <Report />
            <AuthorizeView>
                <Authorized>
                    <a class="map-header-button account-button" href="/Account/Manage">@context.User.Identity?.Name</a>
                    <form action="/Account/Logout" method="post" class="map-logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button class="map-header-button" type="submit">로그아웃</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="map-header-button login-button" href="/Account/Login?ReturnUrl=%2Fmap">로그인</a>
                </NotAuthorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a class="map-header-button admin-button" href="/places">장소관리</a>
                </Authorized>
            </AuthorizeView>
        </nav>
    </header>

@if (isFilterModalOpen)
{
    <div class="filter-backdrop" @onclick="CancelFilter">
        <section class="filter-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="filter-title"
                 @onclick:stopPropagation="true">

            <header class="filter-modal-header">
                <div>
                    <h3 id="filter-title">장소 필터</h3>
                    <p>지도에 표시할 장소 유형을 선택하세요.</p>
                </div>

                <button type="button"
                        class="filter-close"
                        aria-label="닫기"
                        @onclick="CancelFilter">
                    ×
                </button>
            </header>

            <nav class="filter-tabs" aria-label="카테고리 그룹">
                @foreach (var group in categoryGroups)
                {
                    <button type="button"
                            @key="group.Key"
                            class="@(activeCategoryGroupKey == group.Key ? "active" : "")"
                            aria-pressed="@(activeCategoryGroupKey == group.Key)"
                            @onclick="() => SelectCategoryGroup(group.Key)">
                        @group.Title
                    </button>
                }
            </nav>

            <div class="filter-selection-summary">
                <span>@GetDraftFilterText()</span>

                <button type="button"
                        @onclick="ClearDraftFilter">
                    선택 초기화
                </button>
            </div>

            <div class="filter-category-list">
                @foreach (var category in GetActiveCategories())
                {
                    <label class="filter-category-item"
                           @key="category">

                        <input type="checkbox"
                               checked="@draftCategories.Contains(category)"
                               @onchange="e => ToggleCategory(category, e)" />

                        <span>@GetCategoryLabel(category)</span>
                    </label>
                }
            </div>

            <footer class="filter-modal-footer">
                <button type="button"
                        class="filter-cancel-button"
                        @onclick="CancelFilter">
                    취소
                </button>

                <button type="button"
                        class="filter-save-button"
                        @onclick="SaveFilter">
                    적용하기
                </button>
            </footer>
        </section>
    </div>
}

<div class="map-body">
        <aside class="place-detail-panel @(selectedPlace is null ? "" : "open")" aria-label="장소 상세 정보" aria-hidden="@(selectedPlace is null)">
            @if (selectedPlace is not null)
            {
            <header class="place-detail-header">
                <span>장소 정보</span>
                <button type="button" aria-label="상세 정보 닫기" @onclick="ClosePlaceDetails">×</button>
            </header>
            @if (selectedPlaceImages.Count > 0)
            {
                <img class="place-detail-cover" src="@selectedPlaceImages[0]" alt="@selectedPlace.Name 사진" />
            }
            <section class="place-detail-main">
                <div class="place-detail-meta"><span>@selectedPlace.Category</span><span>제보일 @(selectedPlace.ReportDate?.ToString("yyyy.MM.dd") ?? "정보 없음")</span></div>
                <h2>@selectedPlace.Name</h2>
                <p class="place-detail-address">@selectedPlace.Address</p>
                <div class="place-detail-actions">
                    <button type="button" class="favorite-button @(isFavorite ? "active" : "")" @onclick="ToggleFavoriteAsync">♡ @(isFavorite ? "찜 완료" : "찜")</button>
                    <a class="naver-place-button" href="@GetNaverSearchUrl(selectedPlace)" target="_blank" rel="noopener noreferrer">네이버 지도에서 검색하기 ↗</a>
                </div>
                @if (selectedPlace.Category.Contains("Restaurant", StringComparison.OrdinalIgnoreCase))
                {
                    <h3>메뉴</h3><p>@(string.IsNullOrWhiteSpace(selectedPlace.Menu) ? "등록된 메뉴 정보가 없습니다." : selectedPlace.Menu)</p>
                }
                <h3>태그</h3>
                <div class="place-detail-tags">
                    @if (!string.IsNullOrWhiteSpace(selectedPlace.RestaurantType))
                    { <span>@selectedPlace.RestaurantType</span> }
                    @foreach (var tag in selectedPlace.Category.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                    {
                        var tagLabel = Enum.TryParse<AnimalCategory>(tag, out var parsed) ? GetCategoryLabel(parsed) : tag;
                        <span>@tagLabel</span>
                    }
                </div>
                <h3>영업시간</h3><p>@(selectedPlace.BusinessHours ?? "정보 없음")</p>
                <h3>메모</h3><p>@(selectedPlace.Memo ?? selectedPlace.Description ?? "등록된 메모가 없습니다.")</p>
                <h3>종합평점</h3>
                <div class="place-rating-summary">@(selectedPlace.RatingCount > 0 ? $"★ {selectedPlace.AverageRating:F1} ({selectedPlace.RatingCount}명)" : "아직 평가가 없습니다.")</div>
                <div class="place-rate-control" aria-label="평점 평가하기">
                    <span>평점 평가하기</span>
                    @if (isAuthenticated)
                    {
                        @for (var score = 1; score <= 5; score++)
                        {
                            var selectedScore = score;
                            <button type="button" aria-label="@($"{selectedScore}점 평가")" class="@(selectedScore <= currentUserRating ? "selected" : "")" @onclick="() => RateSelectedPlaceAsync(selectedScore)">★</button>
                        }
                    }
                    else { <a href="/Account/Login?ReturnUrl=%2Fmap">로그인 후 평가</a> }
                </div>
                <div id="place-mini-map" class="place-mini-map" aria-label="장소 위치 지도"></div>
                <p class="place-detail-address">@selectedPlace.Address</p>
            </section>

            <section class="place-comments">
                <div class="place-comments-heading"><h3>댓글 <span>@placeComments.Count</span></h3>
                    <div><button type="button" class="@(commentSort == "latest" ? "active" : "")" @onclick='() => SortComments("latest")'>최신순</button><button type="button" class="@(commentSort == "likes" ? "active" : "")" @onclick='() => SortComments("likes")'>좋아요 순</button></div>
                </div>
                @if (isAuthenticated)
                {
                    <div class="comment-login-note">@currentAuthorName 회원으로 댓글을 남겨보세요.</div>
                }
                else
                {
                    <div class="guest-comment-fields"><input @bind="guestName" placeholder="비회원 아이디" maxlength="80" /><input @bind="guestPassword" type="password" placeholder="비회원 비밀번호" /></div>
                    <div class="comment-login-note">회원으로 댓글을 남겨보세요. <a href="/Account/Login?ReturnUrl=%2Fmap">로그인 / 회원가입</a></div>
                }
                <textarea @bind="commentText" maxlength="2000" placeholder="장소에 대한 경험을 남겨주세요."></textarea>
                <div class="comment-compose-footer"><label class="comment-image-upload">이미지 추가 @commentImages.Count/5<InputFile OnChange="HandleCommentImages" multiple accept="image/*" /></label><button type="button" @onclick="SubmitCommentAsync">등록</button></div>
                @if (!string.IsNullOrWhiteSpace(commentError)) { <p class="comment-error">@commentError</p> }
                @if (placeComments.Count == 0)
                {
                    <div class="no-comments">아직 댓글이 없습니다.<br /><small>첫 번째 댓글을 남겨보세요.</small></div>
                }
                else
                {
                    @foreach (var comment in placeComments)
                    {
                        <article class="place-comment" @key="comment.Id">
                            <div class="place-comment-top"><strong>@comment.AuthorName</strong><span>@(comment.Rating.HasValue ? $"★ {comment.Rating:F1}" : "평점 없음")</span><time>@comment.CreatedAt.ToString("yyyy.MM.dd")</time></div>
                            <p>@comment.Content</p>
                            @if (comment.ImagePaths.Count > 0) { <div class="place-comment-images">@foreach (var image in comment.ImagePaths) { <img src="@image" alt="댓글 첨부 이미지" /> }</div> }
                            @if (isAuthenticated)
                            {
                                <button type="button" class="comment-like @(comment.HasLiked ? "liked" : "")" aria-pressed="@comment.HasLiked" @onclick="() => LikeCommentAsync(comment.Id)">@(comment.HasLiked ? "♥" : "♡") 좋아요 @comment.LikesCount</button>
                            }
                            else
                            {
                                <a class="comment-like" href="/Account/Login?ReturnUrl=%2Fmap">♡ 로그인하고 좋아요 @comment.LikesCount</a>
                            }
                        </article>
                    }
                }
            </section>
            }
        </aside>
<div class="map-canvas-wrap">
    <div class="map-search" role="search">
        <div class="map-filter-toolbar">
            <button type="button"
                    class="filter-open-button"
                    @onclick="OpenFilter">
                <span aria-hidden="true">☷</span>
                <span>지도 표시 필터</span>
                <span class="filter-count">@GetFilterButtonText()</span>
            </button>
        </div>
        <div class="map-search-input-row">
            <span class="map-search-icon" aria-hidden="true">⌕</span>
            <input type="search"
                   placeholder="장소 이름이나 주소를 검색하세요"
                   aria-label="장소 검색"
                   autocomplete="off"
                   @bind="searchKeyword"
                   @bind:event="oninput"
                   @bind:after="SearchPlacesAsync" />
            @if (!string.IsNullOrWhiteSpace(searchKeyword))
            {
                <button type="button" class="search-clear" aria-label="검색어 지우기" @onclick="ClearSearch">×</button>
            }
        </div>
        <div class="map-search-categories" aria-label="검색 카테고리">
            <button type="button"
                    class="@(selectedSearchCategories.Count == 0 ? "active" : "")"
                    aria-pressed="@(selectedSearchCategories.Count == 0)"
                    @onclick="ClearSearchCategories">전체</button>
            @foreach (var category in Enum.GetValues<AnimalCategory>())
            {
                <button type="button"
                        @key="category"
                        class="@(selectedSearchCategories.Contains(category) ? "active" : "")"
                        aria-pressed="@selectedSearchCategories.Contains(category)"
                        @onclick="() => ToggleSearchCategory(category)">@GetSearchCategoryLabel(category)</button>
            }
        </div>
        @foreach (var category in Enum.GetValues<AnimalCategory>()
            .Where(category => selectedSearchCategories.Contains(category)
                && GetSearchSubcategories(category).Length > 0))
        {
            <div class="map-search-subcategory-group" @key="category">
                <span>@GetSearchCategoryLabel(category)</span>
                <div class="map-search-subcategories" aria-label="@($"{GetSearchCategoryLabel(category)} 세부 카테고리")">
                <button type="button"
                        class="@(!HasSelectedSubcategories(category) ? "active" : "")"
                        aria-pressed="@(!HasSelectedSubcategories(category))"
                        @onclick="() => ClearSearchSubcategories(category)">전체</button>
                @foreach (var subtype in GetSearchSubcategories(category))
                {
                    <button type="button"
                            @key="subtype"
                            class="@(IsSearchSubtypeSelected(category, subtype) ? "active" : "")"
                            aria-pressed="@IsSearchSubtypeSelected(category, subtype)"
                            @onclick="() => ToggleSearchSubtype(category, subtype)">@subtype</button>
                }
                </div>
            </div>
        }

        @if (searchResults.Count > 0)
        {
            <div class="map-search-results">
                @foreach (var place in searchResults)
                {
                    <button type="button" class="map-search-result" @key="place.PlaceUrl" @onclick="() => FocusPlace(place)">
                        <span class="result-pin" aria-hidden="true">●</span>
                        <span class="result-copy">
                            <strong>@place.Name</strong>
                            <small>@place.Category · @(string.IsNullOrWhiteSpace(place.RoadAddress) ? place.Address : place.RoadAddress)</small>
                        </span>
                    </button>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(searchKeyword) && searchKeyword.Trim().Length >= 2)
        {
            <div class="map-search-empty">검색된 장소가 없습니다.</div>
        }
    </div>
    <div class="map-district-legend" aria-label="안양시 구 경계 범례">
        <strong>안양시 행정구역</strong>
        <span><i class="district-swatch manan"></i>만안구</span>
        <span><i class="district-swatch dongan"></i>동안구</span>
        <small>경계 자료: 국가공간정보포털</small>
    </div>
    <div id="map"></div>
</div>
</div>
</div>

