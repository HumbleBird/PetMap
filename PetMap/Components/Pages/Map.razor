@page "/"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using PetMap.Components.Pages.Places
@using PetMap.Data.Utiles

@inject IJSRuntime JS
@inject PetMap.Data.ApplicationDbContext Db

<h3>PetMap</h3>

<Report />

<div style="margin-bottom: 15px;">
    @foreach (var category in Enum.GetValues(typeof(AnimalCategory)).Cast<AnimalCategory>())
    {
        <button @onclick='() => FilterCategory(category.ToString())'>
            @category
        </button>
    }

</div>

<div id="map"></div>

<style>
    #map {
        width: 100%;
        height: 600px;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // DB에서 장소 가져오기
            var places = await Db.Places
                .Select(p => new
                {
                    p.Id,
                    p.Name,
                    p.Address,
                    p.Latitude,
                    p.Longitude,
                    p.Description,
                    p.Category
                })
                .ToListAsync();

            // JS로 전달
            await JS.InvokeVoidAsync("petMap.init", places);
        }
    }

    private async Task FilterCategory(string category)
    {
        await JS.InvokeVoidAsync("petMap.filterCategory", category);
    }
}