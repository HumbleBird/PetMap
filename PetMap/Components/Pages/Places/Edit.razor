@page "/places/edit/{Id:int}"

@rendermode InteractiveServer
@using PetMap.Data.Entities

@inject PetMap.Data.ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>장소 수정</h3>

@if (place == null)
{
    <p>불러오는 중...</p>
}
else
{
    <EditForm Model="place" OnValidSubmit="UpdatePlace">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>장소명</label>

            <InputText class="form-control"
                       @bind-Value="place.Name" />
        </div>

        <div class="mb-3">
            <label>주소</label>

            <InputText class="form-control"
                       @bind-Value="place.Address" />
        </div>

        <div class="mb-3">
            <label>카테고리</label>

            <InputSelect class="form-select"
                         @bind-Value="place.Category">

                <option value="">선택하세요</option>
                <option value="동물병원">동물병원</option>
                <option value="용품점">용품점</option>
                <option value="공원">공원</option>
                <option value="미용">미용</option>

            </InputSelect>
        </div>

        <div class="mb-3">
            <label>위도</label>

            <InputNumber class="form-control"
                         @bind-Value="place.Latitude" />
        </div>

        <div class="mb-3">
            <label>경도</label>

            <InputNumber class="form-control"
                         @bind-Value="place.Longitude" />
        </div>

        <div class="mb-3">
            <label>설명</label>

            <InputTextArea class="form-control"
                           @bind-Value="place.Description" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            저장
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Cancel">
            취소
        </button>

    </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private Place? place;

    protected override async Task OnInitializedAsync()
    {
        place = await Db.Places.FindAsync(Id);
    }

    private async Task UpdatePlace()
    {
        if (place == null)
            return;

        await Db.SaveChangesAsync();

        Navigation.NavigateTo("/places");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/places");
    }
}