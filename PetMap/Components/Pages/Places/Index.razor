@page "/places"
@layout AccountLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using Microsoft.EntityFrameworkCore
@using PetMap.Data.Entities
@using PetMap.Data.Utiles
@inject PetMap.Data.ApplicationDbContext Db

<PageTitle>장소 관리</PageTitle>
<div class="account-content places-admin-content">
<h3>장소 관리</h3>

<div class="places-admin-tabs" role="tablist" aria-label="장소 관리 메뉴">
    <button type="button" role="tab" aria-selected="@(activeTab == "places")" class="@(activeTab == "places" ? "active" : "")" @onclick="SelectPlacesTab">현재 적용된 장소 <span>@(places?.Count ?? 0)</span></button>
    <button type="button" role="tab" aria-selected="@(activeTab == "requests")" class="@(activeTab == "requests" ? "active" : "")" @onclick="SelectRequestsTab">승인 요청 <span>@(approvalRequests?.Count ?? 0)</span></button>
</div>

<PlaceManagementFilterBar SearchText="@filterSearchText" SearchTextChanged="UpdateFilterSearchText"
                          SelectedCategory="@filterCategory" SelectedCategoryChanged="UpdateFilterCategory" />

@if (activeTab == "places")
{
    <div class="place-management-toolbar">
        <span>현재 적용된 장소 @(places?.Count ?? 0)건 · 선택 @(selectedPlaceIds.Count)건</span>
        <div class="place-management-toolbar-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SelectAllPlaces" disabled="@(FilteredPlaces.Count == 0)">전체 선택</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearPlaceSelection" disabled="@(selectedPlaceIds.Count == 0)">선택 해제</button>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedPlaces" disabled="@(selectedPlaceIds.Count == 0)">선택 삭제</button>
        </div>
    </div>
    @if (places is null)
    {
        <p>장소 목록을 불러오는 중...</p>
    }
    else if (FilteredPlaces.Count == 0)
    {
        <p class="approval-empty-state">검색 조건에 맞는 장소가 없습니다.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table place-management-table">
                <thead>
                    <tr><th scope="col"><span class="visually-hidden">선택</span></th><th>장소명</th><th>카테고리</th><th>주소</th><th>관리</th></tr>
                </thead>
                <tbody>
                    @foreach (var place in FilteredPlaces)
                    {
                        <tr @key="place.Id">
                            <td><input type="checkbox" aria-label="@place.Name 선택" checked="@selectedPlaceIds.Contains(place.Id)" @onchange="args => SetPlaceSelected(place.Id, args.Value is true)" /></td>
                            <td>@place.Name</td><td>@place.Category</td><td>@place.Address</td>
                            <td class="place-admin-row-actions">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenEditModal(place)">수정</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeletePlace(place.Id)">삭제</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(placeActionMessage))
    {
        <p class="approval-action-message" role="status">@placeActionMessage</p>
    }
}
else
{
    <div class="approval-request-toolbar">
        <span>검토 대기 중인 장소 제보 @(FilteredRequests.Count)건 · 선택 @(selectedRequestIds.Count)건</span>
        <div>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SelectAllRequests" disabled="@(FilteredRequests.Count == 0)">전체 선택</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearRequestSelection" disabled="@(selectedRequestIds.Count == 0)">선택 해제</button>
            <button type="button" class="btn btn-success btn-sm" @onclick="ApproveSelectedRequests" disabled="@(selectedRequestIds.Count == 0)">선택 승인 (@selectedRequestIds.Count)</button>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedRequests" disabled="@(selectedRequestIds.Count == 0)">선택 삭제</button>
        </div>
    </div>
    @if (approvalRequests is null)
    {
        <p>승인 요청을 불러오는 중...</p>
    }
    else if (FilteredRequests.Count == 0)
    {
        <p class="approval-empty-state">검색 조건에 맞는 장소 제보가 없습니다.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table approval-request-table">
                <thead>
                    <tr><th scope="col"><span class="visually-hidden">선택</span></th><th scope="col">장소명</th><th scope="col">카테고리</th><th scope="col">주소</th><th scope="col">요청자</th><th scope="col">요청시간</th><th scope="col">관리</th></tr>
                </thead>
                <tbody>
                    @foreach (var request in FilteredRequests)
                    {
                        <tr @key="request.Id">
                            <td><input type="checkbox" aria-label="@request.PlaceName 선택" checked="@selectedRequestIds.Contains(request.Id)" @onchange="args => SetRequestSelected(request.Id, args.Value is true)" /></td>
                            <td>@request.PlaceName</td><td>@request.Category</td><td>@GetRequestAddress(request)</td><td>@request.Nickname</td>
                            <td><time datetime="@request.CreatedAt.ToString("O")">@request.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time></td>
                            <td class="place-admin-row-actions">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenReviewModal(request)">수정</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRequest(request.Id)">삭제</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(requestActionMessage))
    {
        <p class="approval-action-message" role="status">@requestActionMessage</p>
    }
}

@if (editingPlace is not null)
{
    <!-- 편집 사본을 모달에 바인딩해 취소 시 DB 목록의 값은 바뀌지 않게 한다. -->
    <ModalShell Title="장소 수정" TitleId="place-edit-title" OnClose="CloseEditModal">
        <ChildContent>
            <EditForm id="place-edit-form" Model="editingPlace" OnValidSubmit="SaveEdit">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(validationMessage))
                {
                    <div class="alert alert-warning">@validationMessage</div>
                }

                    <div class="mb-3">
                        <label class="form-label">장소명</label>
                        <InputText class="form-control" @bind-Value="editingPlace.Name" />
                    </div>

                    <PlaceCategorySelector @bind-SelectedCategories="selectedCategories" MaxSelected="3" />

                    @if (selectedCategories.Contains(nameof(AnimalCategory.Restaurant)))
                    {
                        <div class="mb-3">
                            <label class="form-label">식당 세부 분류</label>
                            <InputSelect class="form-select" @bind-Value="editingPlace.RestaurantType">
                                <option value="">선택 안 함</option><option value="한식">한식</option><option value="중식">중식</option>
                                <option value="일식">일식</option><option value="양식">양식</option><option value="분식">분식</option>
                                <option value="주점">주점</option><option value="기타">기타</option>
                            </InputSelect>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">메뉴 (음식점)</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="editingPlace.Menu" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">전화번호</label>
                        <InputText class="form-control" @bind-Value="editingPlace.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">주소</label>
                        <InputText class="form-control" @bind-Value="editingPlace.Address" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">도로명 주소</label>
                        <InputText class="form-control" @bind-Value="editingPlace.RoadAddress" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">지번 주소</label>
                        <InputText class="form-control" @bind-Value="editingPlace.JibunAddress" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">위도</label>
                            <InputNumber class="form-control" @bind-Value="editingPlace.Latitude" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">경도</label>
                            <InputNumber class="form-control" @bind-Value="editingPlace.Longitude" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">영업시간</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="editingPlace.BusinessHours" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">장소 설명</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="editingPlace.Description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">네이버 장소 링크</label>
                        <InputText class="form-control" @bind-Value="editingPlace.NaverPlaceUrl" />
                    </div>

                    <details class="mb-3">
                        <summary>제보 기록</summary>
                        <div class="mt-3">
                            <label class="form-label">제보자 닉네임</label>
                            <InputText class="form-control mb-3" @bind-Value="editingPlace.Nickname" />
                            <label class="form-label">리뷰</label>
                            <InputTextArea class="form-control mb-3" rows="3" @bind-Value="editingPlace.Review" />
                            <label class="form-label">메모</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="editingPlace.Memo" />
                        </div>
                    </details>
            </EditForm>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">취소</button>
            <button type="submit" form="place-edit-form" class="btn btn-primary">저장</button>
        </FooterContent>
    </ModalShell>
}

@if (reviewingRequest is not null)
{
    <ModalShell Title="장소 제보 검토" TitleId="place-request-review-title" CssClass="place-review-modal" OnClose="CloseReviewModal" CloseOnBackdrop="false">
        <ChildContent>
            @if (reviewQueue.Count > 1)
            {
                <div class="place-review-navigation" aria-label="제보 탐색">
                    <button type="button" class="place-review-arrow previous" aria-label="이전 제보" @onclick="() => MoveReviewRequest(-1)">‹</button>
                    <span>@(reviewIndex + 1) / @reviewQueue.Count</span>
                    <button type="button" class="place-review-arrow next" aria-label="다음 제보" @onclick="() => MoveReviewRequest(1)">›</button>
                </div>
            }
            <p class="place-review-meta">요청자 <strong>@reviewingRequest.Nickname</strong> · @reviewingRequest.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            @if (!string.IsNullOrWhiteSpace(requestActionMessage))
            {
                <p class="approval-action-message" role="status">@requestActionMessage</p>
            }
            <EditForm id="place-request-review-form" Model="reviewingRequest">
                <div class="mb-3"><label class="form-label">장소명</label><InputText class="form-control" @bind-Value="reviewingRequest.PlaceName" /></div>
                <PlaceCategorySelector @bind-SelectedCategories="requestSelectedCategories" MaxSelected="3" />
                @if (requestSelectedCategories.Contains(nameof(AnimalCategory.Restaurant)))
                {
                    <div class="mb-3">
                        <label class="form-label">식당 세부 분류</label>
                        <InputSelect class="form-select" @bind-Value="reviewingRequest.RestaurantType">
                            <option value="">선택 안 함</option><option value="한식">한식</option><option value="중식">중식</option>
                            <option value="일식">일식</option><option value="양식">양식</option><option value="분식">분식</option>
                            <option value="주점">주점</option><option value="기타">기타</option>
                        </InputSelect>
                    </div>
                }
                <div class="mb-3"><label class="form-label">주소</label><InputText class="form-control" @bind-Value="reviewingRequest.Address" /></div>
                <div class="mb-3"><label class="form-label">도로명 주소</label><InputText class="form-control" @bind-Value="reviewingRequest.RoadAddress" /></div>
                <div class="mb-3"><label class="form-label">지번 주소</label><InputText class="form-control" @bind-Value="reviewingRequest.JibunAddress" /></div>
                <div class="mb-3"><label class="form-label">전화번호</label><InputText class="form-control" @bind-Value="reviewingRequest.Phone" /></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label class="form-label">위도</label><InputNumber class="form-control" @bind-Value="reviewingRequest.Latitude" /></div>
                    <div class="col-md-6 mb-3"><label class="form-label">경도</label><InputNumber class="form-control" @bind-Value="reviewingRequest.Longitude" /></div>
                </div>
                <div class="mb-3"><label class="form-label">영업시간</label><InputText class="form-control" @bind-Value="reviewingRequest.BusinessHours" /></div>
                <div class="mb-3"><label class="form-label">네이버 장소 링크</label><InputText class="form-control" @bind-Value="reviewingRequest.NaverPlaceUrl" /></div>
                <div class="mb-3"><label class="form-label">장소 설명 / 제보 내용</label><InputTextArea class="form-control" rows="4" @bind-Value="reviewingRequest.Review" /></div>
                <div class="mb-3"><label class="form-label">메모</label><InputTextArea class="form-control" rows="3" @bind-Value="reviewingRequest.Memo" /></div>
            </EditForm>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseReviewModal">닫기</button>
            <button type="button" class="btn btn-outline-primary" @onclick="SaveRequestEdit">수정 저장</button>
            <button type="button" class="btn btn-success" @onclick="ApproveCurrentRequest">승인</button>
        </FooterContent>
    </ModalShell>
}

</div>

@code {
    private List<Place>? places;
    private List<PlaceReport>? approvalRequests;
    private Place? editingPlace;
    private PlaceReport? reviewingRequest;
    private List<PlaceReport> reviewQueue = [];
    private HashSet<int> selectedRequestIds = [];
    private HashSet<int> selectedPlaceIds = [];
    private string activeTab = "places";
    private string? requestActionMessage;
    private string? placeActionMessage;
    private int reviewIndex;
    private HashSet<string> selectedCategories = new(StringComparer.Ordinal);
    private HashSet<string> requestSelectedCategories = new(StringComparer.Ordinal);
    private string filterSearchText = "";
    private string filterCategory = "";
    private string? validationMessage;
    private IReadOnlyList<Place> FilteredPlaces => FilterPlaces(places ?? []);
    private IReadOnlyList<PlaceReport> FilteredRequests => FilterRequests(approvalRequests ?? []);

    private IReadOnlyList<Place> FilterPlaces(IEnumerable<Place> source) => source
        .Where(place => MatchesFilters(place.Name, place.Category))
        .ToList();

    private IReadOnlyList<PlaceReport> FilterRequests(IEnumerable<PlaceReport> source) => source
        .Where(report => MatchesFilters(report.PlaceName, report.Category))
        .ToList();

    private bool MatchesFilters(string name, string? categories)
    {
        if (!string.IsNullOrWhiteSpace(filterSearchText)
            && !name.Contains(filterSearchText.Trim(), StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrWhiteSpace(filterCategory)) return true;
        return (categories ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(PlaceCategoryCatalog.Normalize)
            .Contains(filterCategory, StringComparer.OrdinalIgnoreCase);
    }

    private Task UpdateFilterSearchText(string value)
    {
        filterSearchText = value;
        ClearFilteredSelection();
        return Task.CompletedTask;
    }

    private Task UpdateFilterCategory(string value)
    {
        filterCategory = value;
        ClearFilteredSelection();
        return Task.CompletedTask;
    }

    private void ClearFilteredSelection()
    {
        selectedPlaceIds.Clear();
        selectedRequestIds.Clear();
    }

    protected override async Task OnInitializedAsync()
    {
        places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
        await LoadPendingRequests();
    }

    private async Task LoadPendingRequests()
    {
        approvalRequests = await Db.PlaceReports
            .AsNoTracking()
            .Where(report => report.Status == Status.Pending && !report.Review.StartsWith("[장소 신고]"))
            .OrderBy(report => report.CreatedAt)
            .ThenBy(report => report.Id)
            .ToListAsync();
        selectedRequestIds.RemoveWhere(id => approvalRequests.All(report => report.Id != id));
    }

    private void SelectPlacesTab() => activeTab = "places";
    private void SelectRequestsTab() => activeTab = "requests";

    private static string GetRequestAddress(PlaceReport report) =>
        FirstNonEmpty(report.Address, report.RoadAddress, report.JibunAddress) ?? "주소 미입력";

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private static HashSet<string> ParseCategories(string? value) =>
        (value ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(PlaceCategoryCatalog.Normalize)
            .ToHashSet(StringComparer.Ordinal);

    private static string SerializeCategories(IEnumerable<string> selected) =>
        string.Join(", ", Enum.GetValues<AnimalCategory>()
            .Select(category => category.ToString())
            .Where(selected.Contains));

    private static bool HasCategory(string? categories, AnimalCategory category) =>
        ParseCategories(categories).Contains(category.ToString());

    private bool UpdateReviewCategories()
    {
        if (reviewingRequest is null) return false;
        if (requestSelectedCategories.Count is 0 or > 3)
        {
            requestActionMessage = "카테고리는 1개 이상 3개 이하로 선택해 주세요.";
            return false;
        }

        reviewingRequest.Category = SerializeCategories(requestSelectedCategories);
        if (!requestSelectedCategories.Contains(nameof(AnimalCategory.Restaurant)))
            reviewingRequest.RestaurantType = null;
        return true;
    }

    private void SelectAllRequests()
    {
        selectedRequestIds = FilteredRequests.Select(report => report.Id).ToHashSet();
    }

    private void ClearRequestSelection() => selectedRequestIds.Clear();

    private void SetRequestSelected(int id, bool selected)
    {
        if (selected) selectedRequestIds.Add(id);
        else selectedRequestIds.Remove(id);
    }

    private void SelectAllPlaces() => selectedPlaceIds = FilteredPlaces.Select(place => place.Id).ToHashSet();

    private void ClearPlaceSelection() => selectedPlaceIds.Clear();

    private void SetPlaceSelected(int id, bool selected)
    {
        if (selected) selectedPlaceIds.Add(id);
        else selectedPlaceIds.Remove(id);
    }

    private static PlaceReport CopyReport(PlaceReport report) => new()
    {
        Id = report.Id,
        Nickname = report.Nickname,
        PlaceName = report.PlaceName,
        Category = report.Category,
        RestaurantType = report.RestaurantType,
        Address = report.Address,
        RoadAddress = report.RoadAddress,
        JibunAddress = report.JibunAddress,
        Phone = report.Phone,
        TargetPlaceId = report.TargetPlaceId,
        Latitude = report.Latitude,
        Longitude = report.Longitude,
        NaverPlaceUrl = report.NaverPlaceUrl,
        BusinessHours = report.BusinessHours,
        Review = report.Review,
        Memo = report.Memo,
        Status = report.Status,
        AdminComment = report.AdminComment,
        CreatedAt = report.CreatedAt
    };

    private void OpenReviewModal(PlaceReport report)
    {
        if (approvalRequests is null) return;
        reviewQueue = FilteredRequests.ToList();
        reviewIndex = reviewQueue.FindIndex(item => item.Id == report.Id);
        if (reviewIndex < 0) return;
        reviewingRequest = CopyReport(reviewQueue[reviewIndex]);
        requestSelectedCategories = ParseCategories(reviewingRequest.Category);
        requestActionMessage = null;
    }

    private void MoveReviewRequest(int offset)
    {
        if (reviewQueue.Count == 0) return;
        reviewIndex = (reviewIndex + offset + reviewQueue.Count) % reviewQueue.Count;
        reviewingRequest = CopyReport(reviewQueue[reviewIndex]);
        requestSelectedCategories = ParseCategories(reviewingRequest.Category);
        requestActionMessage = null;
    }

    private void CloseReviewModal()
    {
        reviewingRequest = null;
        reviewQueue = [];
        requestActionMessage = null;
    }

    private bool ValidateRequest(PlaceReport report)
    {
        if (string.IsNullOrWhiteSpace(report.PlaceName) || report.PlaceName.Trim().Length > 200
            || string.IsNullOrWhiteSpace(report.Category) || report.Category.Trim().Length > 200
            || !double.IsFinite(report.Latitude) || !double.IsFinite(report.Longitude)
            || report.Latitude is < -90 or > 90 || report.Longitude is < -180 or > 180)
        {
            requestActionMessage = "장소명, 카테고리, 좌표를 확인해 주세요.";
            return false;
        }

        return true;
    }

    private async Task SaveRequestEdit()
    {
        if (reviewingRequest is null || !UpdateReviewCategories()) return;
        if (reviewingRequest is null || !ValidateRequest(reviewingRequest)) return;
        var request = await Db.PlaceReports.FindAsync(reviewingRequest.Id);
        if (request is null) return;
        Db.Entry(request).CurrentValues.SetValues(reviewingRequest);
        await Db.SaveChangesAsync();
        await LoadPendingRequests();
        reviewQueue = FilteredRequests.ToList();
        reviewIndex = reviewQueue.FindIndex(item => item.Id == request.Id);
        reviewingRequest = reviewIndex >= 0 ? CopyReport(reviewQueue[reviewIndex]) : null;
        requestActionMessage = "제보 내용을 저장했어요.";
    }

    private async Task<bool> ApplyApproval(PlaceReport report)
    {
        if (!ValidateRequest(report)) return false;

        Place? place;
        if (report.TargetPlaceId is int targetPlaceId)
        {
            place = await Db.Places.FindAsync(targetPlaceId);
            if (place is null)
            {
                requestActionMessage = "수정 대상 장소가 삭제되어 승인할 수 없어요. 요청 내용을 확인해 주세요.";
                return false;
            }
        }
        else
        {
            place = new Place();
            Db.Places.Add(place);
        }

        place.Name = report.PlaceName.Trim();
        place.Category = report.Category.Trim();
        place.Address = FirstNonEmpty(report.Address, report.RoadAddress, report.JibunAddress, place.Address) ?? "";
        place.RoadAddress = FirstNonEmpty(report.RoadAddress, place.RoadAddress);
        place.JibunAddress = FirstNonEmpty(report.JibunAddress, place.JibunAddress);
        place.Phone = FirstNonEmpty(report.Phone, place.Phone);
        place.RestaurantType = HasCategory(report.Category, AnimalCategory.Restaurant) ? report.RestaurantType : null;
        place.Latitude = report.Latitude;
        place.Longitude = report.Longitude;
        place.NaverPlaceUrl = FirstNonEmpty(report.NaverPlaceUrl, place.NaverPlaceUrl);
        place.BusinessHours = FirstNonEmpty(report.BusinessHours, place.BusinessHours);
        var description = report.Review.StartsWith("[정보 수정 제안]", StringComparison.Ordinal)
            ? report.Review["[정보 수정 제안]".Length..].TrimStart()
            : report.Review.Trim();
        place.Description = FirstNonEmpty(description, place.Description);
        place.Review = report.Review;
        place.Nickname = report.Nickname;
        place.Memo = FirstNonEmpty(report.Memo, place.Memo);
        report.Status = Status.Approved;
        report.AdminComment = "관리자가 승인했습니다.";
        return true;
    }

    private async Task ApproveCurrentRequest()
    {
        if (reviewingRequest is null || !UpdateReviewCategories() || !ValidateRequest(reviewingRequest)) return;
        var request = await Db.PlaceReports.FindAsync(reviewingRequest.Id);
        if (request is null) return;
        var originalRequest = CopyReport(request);
        Db.Entry(request).CurrentValues.SetValues(reviewingRequest);
        if (!await ApplyApproval(request))
        {
            Db.Entry(request).CurrentValues.SetValues(originalRequest);
            return;
        }
        await Db.SaveChangesAsync();
        places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
        selectedRequestIds.Remove(request.Id);
        await LoadPendingRequests();
        CloseReviewModal();
    }

    private async Task ApproveSelectedRequests()
    {
        if (approvalRequests is null || selectedRequestIds.Count == 0) return;
        var selected = await Db.PlaceReports
            .Where(report => selectedRequestIds.Contains(report.Id)
                && report.Status == Status.Pending
                && !report.Review.StartsWith("[장소 신고]"))
            .OrderBy(report => report.CreatedAt)
            .ThenBy(report => report.Id)
            .ToListAsync();

        var approvedIds = new List<int>();
        foreach (var report in selected)
        {
            if (await ApplyApproval(report)) approvedIds.Add(report.Id);
        }

        await Db.SaveChangesAsync();
        selectedRequestIds.ExceptWith(approvedIds);
        places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
        await LoadPendingRequests();
        requestActionMessage = $"{approvedIds.Count}건을 승인했어요.";
    }

    private async Task DeleteRequest(int id)
    {
        var request = await Db.PlaceReports.FindAsync(id);
        if (request is null) return;
        Db.PlaceReports.Remove(request);
        await Db.SaveChangesAsync();
        selectedRequestIds.Remove(id);
        if (reviewingRequest?.Id == id) CloseReviewModal();
        await LoadPendingRequests();
    }

    private async Task DeleteSelectedRequests()
    {
        if (selectedRequestIds.Count == 0) return;
        var selected = await Db.PlaceReports
            .Where(report => selectedRequestIds.Contains(report.Id) && report.Status == Status.Pending)
            .ToListAsync();
        Db.PlaceReports.RemoveRange(selected);
        await Db.SaveChangesAsync();
        if (reviewingRequest is not null && selectedRequestIds.Contains(reviewingRequest.Id))
            CloseReviewModal();
        selectedRequestIds.Clear();
        await LoadPendingRequests();
        requestActionMessage = $"{selected.Count}건을 삭제했어요.";
    }

    // 원본 DB 엔티티를 건드리지 않도록 새 편집 사본을 만들어 모달에 연다.
    private void OpenEditModal(Place place)
    {
        editingPlace = CopyPlace(place);
        selectedCategories = ParseCategories(place.Category);
        validationMessage = null;
    }

    private static Place CopyPlace(Place place) => new()
    {
        Id = place.Id,
        Name = place.Name,
        Address = place.Address,
        RoadAddress = place.RoadAddress,
        JibunAddress = place.JibunAddress,
        Latitude = place.Latitude,
        Longitude = place.Longitude,
        Category = place.Category,
        RestaurantType = place.RestaurantType,
        Menu = place.Menu,
        Phone = place.Phone,
        Description = place.Description,
        NaverPlaceUrl = place.NaverPlaceUrl,
        BusinessHours = place.BusinessHours,
        Nickname = place.Nickname,
        Review = place.Review,
        Memo = place.Memo
    };

    // 폼에서 저장을 누를 때만 원본 엔티티를 갱신하고 DB에 반영한다.
    private async Task SaveEdit()
    {
        if (editingPlace is null) return;
        if (selectedCategories.Count is 0 or > 3)
        {
            validationMessage = "카테고리는 1개 이상 3개 이하로 선택해주세요.";
            return;
        }

        var original = await Db.Places.FindAsync(editingPlace.Id);
        if (original is null) return;

        var categoryOrder = Enum.GetNames<AnimalCategory>();
        editingPlace.Category = string.Join(", ", categoryOrder.Where(selectedCategories.Contains));
        if (!selectedCategories.Contains(nameof(AnimalCategory.Restaurant))) editingPlace.RestaurantType = null;
        Db.Entry(original).CurrentValues.SetValues(editingPlace);
        try
        {
            await Db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            validationMessage = "장소를 저장하지 못했어요. 입력값을 확인한 뒤 다시 시도해 주세요.";
            return;
        }

        places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
        CloseEditModal();
    }

    private void CloseEditModal()
    {
        editingPlace = null;
        validationMessage = null;
    }

    private async Task DeletePlace(int id) => await DeletePlaces([id]);

    private async Task DeleteSelectedPlaces()
    {
        if (selectedPlaceIds.Count > 0)
            await DeletePlaces(selectedPlaceIds.ToArray());
    }

    private async Task DeletePlaces(int[] ids)
    {
        var idSet = ids.ToHashSet();
        if (idSet.Count == 0) return;

        await using var transaction = await Db.Database.BeginTransactionAsync();
        try
        {
            var courseStops = await Db.PetCourseStops.Where(stop => idSet.Contains(stop.PlaceId)).ToListAsync();
            Db.PetCourseStops.RemoveRange(courseStops);
            var toDelete = await Db.Places.Where(place => idSet.Contains(place.Id)).ToListAsync();
            if (toDelete.Count == 0) return;

            Db.Places.RemoveRange(toDelete);
            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            selectedPlaceIds.ExceptWith(idSet);
            if (editingPlace is not null && idSet.Contains(editingPlace.Id)) CloseEditModal();
            places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
            placeActionMessage = $"{toDelete.Count}곳을 삭제했어요. 연결된 코스의 해당 장소 항목도 제거했어요.";
        }
        catch (DbUpdateException)
        {
            await transaction.RollbackAsync();
            Db.ChangeTracker.Clear();
            places = await Db.Places.AsNoTracking().OrderBy(place => place.Id).ToListAsync();
            placeActionMessage = "장소를 삭제하지 못했어요. 연결된 데이터가 있어 삭제가 제한되는지 확인해 주세요.";
        }
    }
}
