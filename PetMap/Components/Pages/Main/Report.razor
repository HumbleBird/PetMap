@using PetMap.Data.Entities
@using PetMap.Data
@using PetMap.Data.Utiles

@inject ApplicationDbContext Db
@inject IJSRuntime JS

<!-- 제보 입력 화면은 별도 모달로 표시한다. -->
<button class="report-button"
        @onclick="OpenReportModal">
    + 제보하기
</button>

@* 제보 작성 폼 *@
@if (showReportModal)
{
    <!-- 화면 전체를 어둡게 -->
    <div class="modal-backdrop">

        <!-- 실제 작은 창 -->
        <div class="report-modal">

            <!-- 상단 -->
            <div class="modal-header">

                <h4>장소 제보</h4>

                <!-- 오른쪽 위 X -->
                <button class="close-button"
                        type="button"
                        aria-label="닫기"
                        @onclick="ShowCheckCloseReportModal">
                    ×
                </button>

            </div>


            <!-- 가운데 내용 : 여기가 스크롤됨 -->
            <div class="modal-body">
                <div class="mb-3">

                    <label class="form-label">
                        닉네임
                    </label>

                    <InputText class="form-control"
                               @bind-Value="report.Nickname" />

                </div>

  
                <div class="mb-3">

                    <label class="form-label">
                        상호명 검색
                    </label>

                    <div class="search-box">

                        <input class="form-control"
                               placeholder="상호명을 입력하세요"
                               @bind="searchKeyword"
                               @bind:event="oninput"
                               @bind:after="SearchPlace" />

                        <button class="btn btn-primary"
                                @onclick="SearchPlace">
                            🔍
                        </button>

                    </div>

                    @if (searchKeyword.Length > 0)
                    {
                        <div class="search-result-count">
                            검색 결과 @searchResults.Count 건입니다. (최대 5건까지 표시합니다.)
                        </div>
                    }

                    <div class="search-results">

                        @foreach (var result in searchResults)
                        {
                            <div class="search-result"
                                 @onclick="() => SelectPlace(result)">

                                <div class="result-name">
                                    @result.Name
                                </div>

                                <div class="result-address">
                                    도로명 : @result.RoadAddress
                                </div>

                                <div class="result-address">
                                    지번 : @result.JibunAddress
                                </div>

                            </div>
                        }

                    </div>

                </div>

                <div class="mb-3">

                    <div class="category-box">

                        <div class="category-header">
                            <strong>카테고리</strong>

                            <span class="category-count">
                                선택됨: @selectedCategories.Count/3
                            </span>
                        </div>

                        <div class="category-grid">

                            @foreach (var category in Enum.GetValues(typeof(AnimalCategory))
                                                          .Cast<AnimalCategory>())
                            {
                                var categoryName = category.ToString();
                                var isChecked = selectedCategories.Contains(categoryName);
                                var isDisabled = !isChecked && selectedCategories.Count >= 3;

                                <label class="category-item">

                                    <input type="checkbox"
                                           checked="@isChecked"
                                           disabled="@isDisabled"
                                           @onchange="() => ToggleCategory(categoryName)" />

                                    <span class="category-name">
                                        @categoryName
                                    </span>

                                </label>
                            }

                        </div>

                        @if (selectedCategories.Count == 0)
                        {
                            <div class="category-warning">
                                카테고리를 최소 1개 선택해주세요.
                            </div>
                        }

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        리뷰
                    </label>

                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="report.Review" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        메모 <span>(선택)</span>
                    </label>

                    <InputTextArea class="form-control"
                                   rows="3"
                                   @bind-Value="report.Memo" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        네이버 장소 링크
                    </label>

                    <InputText class="form-control"
                               @bind-Value="report.NaverPlaceUrl" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        영업시간
                    </label>

                    <InputText class="form-control"
                               @bind-Value="report.BusinessHours" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        이미지
                    </label>

                    <InputFile @key="imageInputKey"
                               OnChange="HandleImages"
                               multiple />

                    <div class="mt-2">
                        현재 @imageCount 장
                    </div>

                </div>

    
            </div>

            <!-- 하단 버튼 -->
            <div class="modal-footer">

                <button class="btn btn-secondary"
                        type="button"
                        @onclick="ShowCheckCloseReportModal">
                    취소
                </button>

                <button class="btn btn-primary"
                        @onclick="SubmitReport">
                    등록
                </button>

            </div>

        </div>

    </div>
}

@* 닫기 확인 모달은 작성 폼 위에 겹쳐 표시한다. *@
@if (ShowCloseReportModal)
{
    <!-- 확인 창의 반투명 배경이 뒤쪽 제보 창도 함께 어둡게 만든다. -->
    <div class="close-confirm-backdrop">
        <section class="close-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="close-report-title">
            <header class="close-confirm-header">
                <h5 id="close-report-title">제보를 나갈까요?</h5>
                <p>작성 중인 내용을 임시저장할까요?</p>
            </header>

            <div class="close-confirm-actions">
                <button class="continue-button" type="button" @onclick="ContinueWriting">계속 작성</button>
                <button class="not-save-button" type="button" @onclick="NotSaveTempReport">저장 안 함</button>
                <button class="save-button" type="button" @onclick="SaveTempReport">임시저장</button>
            </div>
        </section>
    </div>
}

