@using PetMap.Data
@using PetMap.Data.Utiles

@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<!-- 제보 입력 화면은 별도 모달로 표시한다. -->
@if (ShowTrigger)
{
    <button class="report-button" @onclick="OpenReportModal">
        <span class="report-button-icon" aria-hidden="true">+</span>
        <span>장소 제보</span>
    </button>
}

@* 제보 작성 폼 *@
@if (showReportModal)
{
    <ModalShell Title="@(editSuggestionMode ? "장소 정보 수정 제안" : "장소 제보")"
                TitleId="place-report-title"
                OnClose="ShowCheckCloseReportModal"
                CloseOnBackdrop="false">
        <ChildContent>
                @if (editSuggestionMode)
                {
                    <div class="mb-3">
                        <label class="form-label">장소명</label>
                        <InputText class="form-control" @bind-Value="report.PlaceName" />
                    </div>
                }
                else
                {
                <div class="mb-3">

                    <label class="form-label">
                        닉네임
                    </label>

                    <InputText class="form-control" @bind-Value="report.Nickname"
                               readonly="@currentUserAuthenticated" />
                    @if (currentUserAuthenticated)
                    {
                        <small class="form-text text-muted">로그인 닉네임은 제보 중 변경할 수 없습니다.</small>
                    }

                </div>
                }

  
                <div class="mb-3">

                    <label class="form-label">
                        상호명 검색
                    </label>

                    <div class="search-box">

                        <input class="form-control"
                               placeholder="상호명을 입력하세요"
                               @bind="searchKeyword"
                               @bind:event="oninput"
                               @bind:after="SearchPlace" />

                        <button class="btn btn-primary"
                                @onclick="SearchPlace">
                            🔍
                        </button>

                    </div>

                    @if (searchKeyword.Length > 0)
                    {
                        <div class="search-result-count">
                            검색 결과 @searchResults.Count 건입니다. (최대 5건까지 표시합니다.)
                        </div>
                    }

                    <div class="search-results">

                        @foreach (var result in searchResults)
                        {
                            <div class="search-result"
                                 @onclick="() => SelectPlace(result)">

                                <div class="result-name">
                                    @result.Name
                                </div>

                                <div class="result-address">
                                    도로명 : @result.RoadAddress
                                </div>

                                <div class="result-address">
                                    지번 : @result.JibunAddress
                                </div>

                            </div>
                        }

                    </div>

                </div>

                <div class="mb-3">

                    <PlaceCategorySelector @bind-SelectedCategories="selectedCategories" MaxSelected="3" ShowMinSelectionWarning="true" />

                    @if (selectedCategories.Contains(nameof(AnimalCategory.Restaurant)))
                    {
                        <div class="mb-3">
                            <label class="form-label">식당 세부 분류</label>
                            <InputSelect class="form-select" @bind-Value="report.RestaurantType">
                                <option value="">선택 안 함</option>
                                <option value="한식">한식</option>
                                <option value="중식">중식</option>
                                <option value="일식">일식</option>
                                <option value="양식">양식</option>
                                <option value="분식">분식</option>
                                <option value="주점">주점</option>
                                <option value="기타">기타</option>
                            </InputSelect>
                        </div>
                    }

                </div>

                <div class="mb-3">

                    <label class="form-label">전화번호</label>

                    <InputText class="form-control" @bind-Value="report.Phone" placeholder="전화번호 (선택)" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        리뷰
                    </label>

                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="report.Review" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        메모 <span>(선택)</span>
                    </label>

                    <InputTextArea class="form-control"
                                   rows="3"
                                   @bind-Value="report.Memo" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        네이버 장소 링크
                    </label>

                    <InputText class="form-control"
                               @bind-Value="report.NaverPlaceUrl" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        영업시간
                    </label>

                    <InputText class="form-control"
                               @bind-Value="report.BusinessHours" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        이미지
                    </label>

                    <InputFile @key="imageInputKey"
                               OnChange="HandleImages"
                               multiple />

                    <div class="mt-2">
                        현재 @imageCount 장
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="text-danger" role="alert">@errorMessage</div>
                    }

                </div>

    
        </ChildContent>
        <FooterContent>
                <button class="btn btn-secondary"
                        type="button"
                        @onclick="ShowCheckCloseReportModal">
                    취소
                </button>

                <button class="btn btn-primary"
                        type="button"
                        @onclick="SubmitReport">
                        @(editSuggestionMode ? "수정 제안 보내기" : "등록")
                </button>
        </FooterContent>
    </ModalShell>
}

@* 닫기 확인 모달은 작성 폼 위에 겹쳐 표시한다. *@
@if (ShowCloseReportModal)
{
    <!-- 확인 창의 반투명 배경이 뒤쪽 제보 창도 함께 어둡게 만든다. -->
    <div class="close-confirm-backdrop">
        <section class="close-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="close-report-title">
            <header class="close-confirm-header">
                <h5 id="close-report-title">제보를 나갈까요?</h5>
                <p>작성 중인 내용을 임시저장할까요?</p>
            </header>

            <div class="close-confirm-actions">
                <button class="continue-button" type="button" @onclick="ContinueWriting">계속 작성</button>
                <button class="not-save-button" type="button" @onclick="NotSaveTempReport">저장 안 함</button>
                <button class="save-button" type="button" @onclick="SaveTempReport">임시저장</button>
            </div>
        </section>
    </div>
}

