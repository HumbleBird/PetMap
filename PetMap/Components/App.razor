@inject IConfiguration Configuration
@{
    var kakaoJavaScriptKey = Configuration["Kakao:JavaScriptKey"];
}
<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PetMap.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />

</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>

    
    
    @if (!string.IsNullOrWhiteSpace(kakaoJavaScriptKey))
    {
        <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=@Uri.EscapeDataString(kakaoJavaScriptKey)&amp;libraries=services"></script>
        <script src="/js/map.js"></script>
        <script type="module" src="/js/index.js"></script>
    }
</body>

</html>
