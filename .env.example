DOMAIN=petmap.example.com
ACME_EMAIL=admin@example.com

# Set both to strong, unique values. The SQL Server SA password must satisfy SQL password complexity rules.
MSSQL_SA_PASSWORD=
DB_APP_PASSWORD=

# Required for production account confirmation and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=PetMap

# Public browser key for Kakao Maps JavaScript SDK. Restrict allowed domains in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=

# Optional: existing accounts with these email addresses receive the Admin role at startup.
ADMIN_EMAIL=
ADMIN_EMAILS=
